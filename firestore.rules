rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /klimatologi/{document} {
      allow read, write: if true;
    }
    match /users/{document} {
      allow read, write: if true;
    }
    match /emailLogs/{document} {
      allow read, write: if true;
    }
    match /system_state/{document} {
      allow read, write: if true;
    }
  }
}
